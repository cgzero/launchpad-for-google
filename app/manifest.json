{
  "name": "Launchpad for Google",
  "description": "A fast, clean launchpad for your Google apps",
  "version": "3.3.0",
  "action": {
      "default_icon": "src/img/icon.png",
      "default_popup": "popup.html"
  },
  "icons": {
    "128": "src/img/icon.png"
  },
  "manifest_version": 3,
  "default_locale": "en",
  "permissions": ["storage"]
}
